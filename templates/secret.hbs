<section class="mql-secret-content standard-form">
  <p>{{localize "MQL.Secret.Explanation"}}</p>

  {{#unless crypto}}
  <p class="mql-warning"><i class="fa-solid fa-triangle-exclamation" inert></i> {{localize "MQL.Secret.NoCrypto"}}</p>
  {{else}}

  <p class="mql-secret-status">
    {{#if on}}<i class="fa-solid fa-lock" inert></i> {{localize "MQL.Secret.StatusOn"}}
    {{else}}<i class="fa-solid fa-lock-open" inert></i> {{localize "MQL.Secret.StatusOff"}}{{/if}}
    · {{status.encrypted}} / {{status.total}} {{localize "MQL.Secret.QuestsEncrypted"}}
  </p>

  {{#unless on}}
  <fieldset>
    <legend>{{localize "MQL.Secret.SetUpTitle"}}</legend>
    <div class="form-group">
      <label>{{localize "MQL.Secret.Word"}}</label>
      <div class="form-fields"><input type="password" name="word" autocomplete="new-password"></div>
    </div>
    <div class="form-group">
      <label>{{localize "MQL.Secret.Repeat"}}</label>
      <div class="form-fields"><input type="password" name="repeat" autocomplete="new-password"></div>
    </div>
    <p class="hint">{{localize "MQL.Secret.WordHint"}}</p>
    <button type="button" data-mql-action="setup"><i class="fa-solid fa-lock" inert></i> {{localize "MQL.Secret.SetUpButton"}}</button>
  </fieldset>
  {{/unless}}

  {{#if on}}
  {{#unless ready}}
  <fieldset>
    <legend>{{localize "MQL.Secret.UnlockTitle"}}</legend>
    <p class="hint">{{localize "MQL.Secret.UnlockHint"}}</p>
    <div class="form-group">
      <label>{{localize "MQL.Secret.Word"}}</label>
      <div class="form-fields"><input type="password" name="word" autocomplete="current-password"></div>
    </div>
    <button type="button" data-mql-action="unlock"><i class="fa-solid fa-key" inert></i> {{localize "MQL.Secret.UnlockButton"}}</button>
  </fieldset>
  {{else}}
  <div class="mql-secret-buttons">
    {{#if status.open}}
    <button type="button" data-mql-action="encrypt"><i class="fa-solid fa-lock" inert></i> {{localize "MQL.Secret.EncryptOpen"}} ({{status.open}})</button>
    {{/if}}
    <button type="button" data-mql-action="forget"><i class="fa-solid fa-eraser" inert></i> {{localize "MQL.Secret.Forget"}}</button>
    <button type="button" data-mql-action="turn-off"><i class="fa-solid fa-lock-open" inert></i> {{localize "MQL.Secret.TurnOff"}}</button>
  </div>
  {{/unless}}
  {{/if}}
  {{/unless}}
</section>
