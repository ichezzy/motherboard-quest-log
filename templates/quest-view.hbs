{{#*inline "clueBody"}}
{{#if html}}<span class="mql-clue-text">{{{html}}}</span>{{/if}}
{{#if link}}
{{#if link.canOpen}}
<a class="mql-link" data-mql-action="open-link" data-uuid="{{link.uuid}}" data-tooltip="{{localize "MQL.View.OpenLink"}}"><i class="{{link.icon}}" inert></i> {{link.name}}</a>
{{else}}
<span class="mql-link"><i class="{{link.icon}}" inert></i> {{link.name}}</span>
{{/if}}
{{/if}}
{{/inline}}
<article class="mql-quest" data-status="{{status}}">
  <header class="mql-quest-head">
    {{#if giver.img}}
    {{#if giver.canOpen}}
    <a class="mql-portrait-link" data-mql-action="open-giver" data-tooltip="{{localize "MQL.View.OpenGiver"}}"
       aria-label="{{localize "MQL.View.OpenGiver"}}: {{giver.name}}"><img class="mql-portrait" src="{{giver.img}}" alt=""></a>
    {{else}}
    <img class="mql-portrait" src="{{giver.img}}" alt="">
    {{/if}}
    {{/if}}
    <div class="mql-quest-titles">
      {{#if showTitle}}<h{{headingLevel}} class="mql-quest-name">{{name}}</h{{headingLevel}}>{{/if}}
      <div class="mql-meta">
        <span class="mql-status" data-status="{{status}}"><i class="{{statusIcon}}" inert></i> {{statusLabel}}</span>
        {{#if urgent}}<span class="mql-urgent"><i class="fa-solid fa-fire" inert></i> {{localize "MQL.View.Urgent"}}</span>{{/if}}
        {{#if giver.name}}
        <span class="mql-giver"><i class="fa-solid fa-user" inert></i>
          {{#if giver.canOpen}}<a class="mql-giver-link" data-mql-action="open-giver" data-tooltip="{{localize "MQL.View.OpenGiver"}}">{{giver.name}}</a>{{else}}{{giver.name}}{{/if}}
        </span>
        {{/if}}
        {{#if location}}<span class="mql-location"><i class="fa-solid fa-location-dot" inert></i> <span>{{{location}}}</span></span>{{/if}}
        {{#if progress.total}}<span class="mql-progress"><i class="fa-solid fa-list-check" inert></i> {{progress.done}}/{{progress.total}}</span>{{/if}}
      </div>
    </div>
  </header>

  {{#if isGM}}
  <div class="mql-gm-bar">
    {{#if hidden}}
    <button type="button" data-mql-action="reveal"><i class="fa-solid fa-eye" inert></i> {{localize "MQL.View.Reveal"}}</button>
    {{else}}
    <button type="button" data-mql-action="hide"><i class="fa-solid fa-eye-slash" inert></i> {{localize "MQL.View.Hide"}}</button>
    {{/if}}
    <label>
      {{localize "MQL.Quest.FIELDS.status.label"}}
      <select data-mql-status>
        {{#each statuses}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    {{#unless closed}}
    <button type="button" data-mql-action="toggle-urgent" aria-pressed="{{#if urgent}}true{{else}}false{{/if}}"
            class="{{#if urgent}}mql-urgent-on{{/if}}">
      <i class="fa-solid fa-fire" inert></i> {{#if urgent}}{{localize "MQL.View.NotUrgent"}}{{else}}{{localize "MQL.View.MarkUrgent"}}{{/if}}
    </button>
    {{/unless}}
    <button type="button" data-mql-action="edit"><i class="fa-solid fa-pen-to-square" inert></i> {{localize "MQL.View.Edit"}}</button>
  </div>
  {{/if}}

  {{#if description}}<section class="mql-description journal-page-content">{{{description}}}</section>{{/if}}

  {{#if objectives.length}}
  <section class="mql-objectives">
    <h4>{{localize "MQL.View.Objectives"}}</h4>
    <ul>
      {{#each objectives}}
      <li class="mql-objective {{#if done}}mql-done{{/if}} {{#unless revealed}}mql-unrevealed{{/unless}}">
        {{#if gm}}
        <button type="button" class="mql-icon-button" data-mql-action="toggle-done" data-id="{{id}}"
                data-tooltip="{{localize "MQL.View.ToggleDone"}}" aria-label="{{localize "MQL.View.ToggleDone"}}">
          <i class="{{#if done}}fa-solid fa-square-check{{else}}fa-regular fa-square{{/if}}" inert></i>
        </button>
        {{else}}
        <i class="mql-check {{#if done}}fa-solid fa-square-check{{else}}fa-regular fa-square{{/if}}" inert></i>
        {{/if}}
        <span class="mql-objective-text">{{{html}}}</span>
        {{#if optional}}<span class="mql-tag">{{localize "MQL.View.Optional"}}</span>{{/if}}
        {{#if gm}}
        <button type="button" class="mql-icon-button mql-reveal-toggle" data-mql-action="toggle-reveal" data-id="{{id}}"
                data-tooltip="{{revealLabel}}" aria-label="{{revealLabel}}">
          <i class="fa-solid {{#if revealed}}fa-eye{{else}}fa-eye-slash{{/if}}" inert></i>
        </button>
        {{/if}}
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  {{#if clueSets.length}}
  <section class="mql-clues mql-clues-gm">
    <h4>{{localize "MQL.View.Clues"}}</h4>
    {{#each clueSets}}
    <div class="mql-conclusion">
      <div class="mql-conclusion-head">
        <i class="fa-solid fa-lightbulb" inert></i>
        <span class="mql-conclusion-text">{{#if html}}{{{html}}}{{else}}<em>{{localize "MQL.View.ConclusionHidden"}}</em>{{/if}}</span>
        <span class="mql-found-count {{#if few}}mql-few{{/if}}"
              {{#if few}}data-tooltip="{{localize "MQL.Edit.FewClues"}}"{{/if}}>{{countLabel}}</span>
      </div>
      {{#if clues.length}}
      <ul>
        {{#each clues}}
        <li class="mql-clue {{#unless found}}mql-unrevealed{{/unless}}">
          <button type="button" class="mql-icon-button" data-mql-action="toggle-found" data-id="{{id}}"
                  data-tooltip="{{localize "MQL.View.ToggleFound"}}" aria-label="{{localize "MQL.View.ToggleFound"}}">
            <i class="{{#if found}}fa-solid fa-square-check{{else}}fa-regular fa-square{{/if}}" inert></i>
          </button>
          {{> clueBody}}
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </div>
    {{/each}}
  </section>
  {{/if}}

  {{#if clues.length}}
  <section class="mql-clues">
    <h4>{{localize "MQL.View.Clues"}}</h4>
    <ul>
      {{#each clues}}
      <li class="mql-clue">
        <i class="mql-check fa-solid fa-magnifying-glass" inert></i>
        {{> clueBody}}
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  {{#if outcome}}
  <section class="mql-outcome">
    <h4><i class="fa-solid fa-code-branch" inert></i> {{localize "MQL.View.Outcome"}}</h4>
    <p>{{{outcome}}}</p>
  </section>
  {{/if}}

  {{#if rewards.show}}
  <section class="mql-rewards {{#unless rewards.handedOut}}mql-gm-only{{/unless}}">
    <h4><i class="fa-solid fa-gift" inert></i>
      {{#if rewards.handedOut}}{{localize "MQL.View.Received"}}{{else}}{{localize "MQL.View.Rewards"}}{{/if}}</h4>
    {{#if rewards.handedOut}}
    {{#if rewards.received.length}}
    <ul class="mql-received">{{#each rewards.received}}<li><strong>{{actor}}:</strong> {{text}}</li>{{/each}}</ul>
    {{/if}}
    {{else}}
    <ul class="mql-reward-list">
      {{#each rewards.items}}<li><img src="{{img}}" alt=""> {{label}}</li>{{/each}}
      {{#if rewards.currency}}<li><i class="fa-solid fa-coins" inert></i> {{rewards.currency}}</li>{{/if}}
    </ul>
    {{/if}}
    {{#if rewards.text}}<p class="mql-reward-note">{{{rewards.text}}}</p>{{/if}}
    {{#if rewards.canHandOut}}
    <div class="mql-reward-actions">
      <button type="button" data-mql-action="hand-out"><i class="fa-solid fa-gift" inert></i> {{localize "MQL.View.HandOut"}}</button>
      <span class="hint">{{localize "MQL.View.RewardsGMOnly"}}</span>
    </div>
    {{/if}}
  </section>
  {{/if}}

  {{#if followUps.length}}
  <section class="mql-follow-ups mql-gm-only">
    <h4><i class="fa-solid fa-bell" inert></i> {{localize "MQL.View.FollowUps"}}</h4>
    <ul>
      {{#each followUps}}
      <li class="mql-follow-up {{#if done}}mql-done{{/if}} {{#if due}}mql-due{{/if}}">
        <button type="button" class="mql-icon-button" data-mql-action="toggle-follow-up" data-id="{{id}}"
                data-tooltip="{{localize "MQL.View.ToggleDone"}}" aria-label="{{localize "MQL.View.ToggleDone"}}">
          <i class="{{#if done}}fa-solid fa-square-check{{else}}fa-regular fa-square{{/if}}" inert></i>
        </button>
        <span class="mql-follow-up-text">{{#if html}}{{{html}}}{{else}}<em>{{placeholder}}</em>{{/if}}</span>
        <span class="mql-tag">{{tag}}</span>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  {{#unless hasContent}}<p class="mql-empty">{{localize "MQL.View.Empty"}}</p>{{/unless}}

  {{#if briefLocked}}
  <p class="mql-brief mql-brief-locked"><i class="fa-solid fa-key" inert></i> {{localize "MQL.View.Brief"}}: {{briefLocked}}</p>
  {{else if brief.length}}
  <details class="mql-brief" {{#if briefOpen}}open{{/if}}>
    <summary><i class="fa-solid fa-user-secret" inert></i> {{localize "MQL.View.Brief"}}</summary>
    <dl>
      {{#each brief}}<dt>{{label}}</dt><dd>{{{html}}}</dd>{{/each}}
    </dl>
  </details>
  {{/if}}
</article>
