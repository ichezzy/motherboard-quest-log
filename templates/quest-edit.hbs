<div class="mql-edit">
  {{formField systemFields.status value=source.system.status localize=true}}
  {{formField systemFields.urgent value=source.system.urgent}}

  <fieldset class="mql-giver-set">
    <legend><i class="fa-solid fa-user" inert></i> {{localize "MQL.Edit.Giver"}}</legend>
    <div class="mql-giver-row">
      <div class="mql-giver-drop" data-mql-drop="giver" data-tooltip="{{localize "MQL.Edit.GiverDrop"}}"
           aria-label="{{localize "MQL.Edit.GiverDrop"}}">
        {{#if giver.img}}<img src="{{giver.img}}" alt="">{{else}}<i class="fa-solid fa-user-plus" inert></i>{{/if}}
      </div>
      <div class="mql-giver-fields">
        {{formField systemFields.giver.fields.name value=giver.name}}
        {{formField systemFields.giver.fields.img value=giver.img}}
      </div>
    </div>
    <p class="hint">
      {{localize "MQL.Edit.GiverHint"}}
      {{#if hasGiver}}
      <button type="button" class="mql-inline-button" data-mql-action="clear-giver">
        <i class="fa-solid fa-xmark" inert></i> {{localize "MQL.Edit.GiverClear"}}
      </button>
      {{/if}}
    </p>
  </fieldset>

  {{formField systemFields.location value=source.system.location}}

  <div class="form-group stacked mql-description-group">
    <label>{{localize "MQL.Quest.FIELDS.description.label"}}</label>
    <prose-mirror name="system.description" value="{{source.system.description}}"
                  data-document-uuid="{{document.uuid}}" class="mql-editor"></prose-mirror>
    <p class="hint">{{localize "MQL.Quest.FIELDS.description.hint"}}</p>
  </div>

  <fieldset class="mql-objectives-set">
    <legend><i class="fa-solid fa-list-check" inert></i> {{localize "MQL.Edit.Objectives"}}</legend>
    <p class="hint">{{localize "MQL.Edit.ObjectivesHint"}}</p>
    {{#if objectives.length}}
    <ol class="mql-objective-rows">
      <li class="mql-objective-head" aria-hidden="true">
        <span>{{localize "MQL.Edit.Objective"}}</span>
        <span>{{localize "MQL.Edit.Revealed"}}</span>
        <span>{{localize "MQL.Edit.Done"}}</span>
        <span>{{localize "MQL.Edit.Optional"}}</span>
        <span></span>
      </li>
      {{#each objectives}}
      <li class="mql-objective-row" data-id="{{id}}">
        <input type="hidden" name="system.objectives.{{@index}}.id" value="{{id}}">
        <input type="text" name="system.objectives.{{@index}}.text" value="{{text}}" data-field="text"
               placeholder="{{localize "MQL.Edit.ObjectivePlaceholder"}}" aria-label="{{localize "MQL.Edit.Objective"}}">
        <input type="checkbox" name="system.objectives.{{@index}}.revealed" data-field="revealed" {{checked revealed}}
               aria-label="{{localize "MQL.Edit.Revealed"}}">
        <input type="checkbox" name="system.objectives.{{@index}}.done" data-field="done" {{checked done}}
               aria-label="{{localize "MQL.Edit.Done"}}">
        <input type="checkbox" name="system.objectives.{{@index}}.optional" data-field="optional" {{checked optional}}
               aria-label="{{localize "MQL.Edit.Optional"}}">
        <span class="mql-row-buttons">
          <button type="button" class="mql-icon-button" data-mql-action="move-up"
                  data-tooltip="{{localize "MQL.Edit.MoveUp"}}" aria-label="{{localize "MQL.Edit.MoveUp"}}">
            <i class="fa-solid fa-arrow-up" inert></i></button>
          <button type="button" class="mql-icon-button" data-mql-action="move-down"
                  data-tooltip="{{localize "MQL.Edit.MoveDown"}}" aria-label="{{localize "MQL.Edit.MoveDown"}}">
            <i class="fa-solid fa-arrow-down" inert></i></button>
          <button type="button" class="mql-icon-button" data-mql-action="delete-objective"
                  data-tooltip="{{localize "MQL.Edit.Delete"}}" aria-label="{{localize "MQL.Edit.Delete"}}">
            <i class="fa-solid fa-trash" inert></i></button>
        </span>
      </li>
      {{/each}}
    </ol>
    {{else}}
    <p class="mql-none">{{localize "MQL.Edit.NoObjectives"}}</p>
    {{/if}}
    <button type="button" class="mql-add" data-mql-action="add-objective">
      <i class="fa-solid fa-plus" inert></i> {{localize "MQL.Edit.AddObjective"}}
    </button>
  </fieldset>

  {{formField systemFields.outcome value=source.system.outcome elementType="textarea" stacked=true classes="mql-outcome-field"}}

  {{!-- No `name` attributes in here: conclusions and clues are saved by their own handlers. --}}
  <fieldset class="mql-clues-set" data-mql-list="clues">
    <legend><i class="fa-solid fa-magnifying-glass" inert></i> {{localize "MQL.Edit.Clues"}}</legend>
    <p class="hint">{{localize "MQL.Edit.CluesHint"}}</p>
    {{#if secretsLocked}}{{#if clueGroups.length}}
    <p class="mql-warning"><i class="fa-solid fa-key" inert></i> {{localize "MQL.Edit.ConclusionsLocked"}}</p>
    {{/if}}{{/if}}
    {{#each clueGroups}}
    <div class="mql-conclusion-edit" data-id="{{id}}">
      <div class="mql-conclusion-head">
        <i class="fa-solid fa-lightbulb" inert></i>
        <input type="text" data-field="text" value="{{text}}"
               placeholder="{{#if ../secretsLocked}}{{localize "MQL.Edit.Encrypted"}}{{else}}{{localize "MQL.Edit.ConclusionPlaceholder"}}{{/if}}"
               aria-label="{{localize "MQL.Edit.Conclusion"}}" {{#if ../secretsLocked}}disabled{{/if}}>
        <span class="mql-found-count {{#if few}}mql-few{{/if}}"
              {{#if few}}data-tooltip="{{localize "MQL.Edit.FewClues"}}"{{/if}}>{{countLabel}}</span>
        {{#unless ../secretsLocked}}
        <button type="button" class="mql-icon-button" data-mql-action="delete-conclusion"
                data-tooltip="{{localize "MQL.Edit.DeleteConclusion"}}" aria-label="{{localize "MQL.Edit.DeleteConclusion"}}">
          <i class="fa-solid fa-trash" inert></i></button>
        {{/unless}}
      </div>
      <ol class="mql-clue-rows">
        {{#each clues}}
        <li class="mql-clue-row" data-id="{{id}}" data-uuid="{{uuid}}" data-name="{{name}}">
          <span class="mql-clue-link {{#unless link}}mql-clue-link-empty{{/unless}} {{#if link.missing}}mql-missing{{/if}}"
                data-tooltip="{{localize "MQL.Edit.ClueDrop"}}">
            {{#if link}}
            <i class="{{link.icon}}" inert></i><span class="mql-clue-link-name">{{link.name}}</span>
            <button type="button" class="mql-icon-button" data-mql-action="clear-link"
                    data-tooltip="{{localize "MQL.Edit.ClearLink"}}" aria-label="{{localize "MQL.Edit.ClearLink"}}">
              <i class="fa-solid fa-xmark" inert></i></button>
            {{else}}
            <i class="fa-solid fa-link" inert></i><span class="mql-clue-link-name">{{localize "MQL.Edit.NoLink"}}</span>
            {{/if}}
          </span>
          <input type="text" data-field="text" value="{{text}}"
                 placeholder="{{localize "MQL.Edit.CluePlaceholder"}}" aria-label="{{localize "MQL.Edit.Clue"}}">
          <label class="mql-found-toggle">
            <input type="checkbox" data-field="found" {{checked found}}> {{localize "MQL.Edit.Found"}}
          </label>
          <button type="button" class="mql-icon-button" data-mql-action="delete-clue"
                  data-tooltip="{{localize "MQL.Edit.DeleteClue"}}" aria-label="{{localize "MQL.Edit.DeleteClue"}}">
            <i class="fa-solid fa-trash" inert></i></button>
        </li>
        {{/each}}
      </ol>
      <button type="button" class="mql-add mql-add-small" data-mql-action="add-clue">
        <i class="fa-solid fa-plus" inert></i> {{localize "MQL.Edit.AddClue"}}
      </button>
    </div>
    {{else}}
    <p class="mql-none">{{localize "MQL.Edit.NoConclusions"}}</p>
    {{/each}}
    {{#unless secretsLocked}}
    <button type="button" class="mql-add" data-mql-action="add-conclusion">
      <i class="fa-solid fa-plus" inert></i> {{localize "MQL.Edit.AddConclusion"}}
    </button>
    {{/unless}}
  </fieldset>

  <fieldset class="mql-rewards-set">
    <legend><i class="fa-solid fa-gift" inert></i> {{localize "MQL.Edit.Rewards"}}</legend>
    <p class="hint">{{localize "MQL.Edit.RewardsHint"}}</p>
    {{#if rewards.handedOut}}
    <div class="mql-handed-out">
      <p><i class="fa-solid fa-circle-check" inert></i> {{localize "MQL.Edit.HandedOut"}}</p>
      {{#if rewards.received.length}}
      <ul>{{#each rewards.received}}<li><strong>{{actor}}:</strong> {{text}}</li>{{/each}}</ul>
      {{/if}}
      <button type="button" class="mql-inline-button" data-mql-action="reset-hand-out">
        <i class="fa-solid fa-rotate-left" inert></i> {{localize "MQL.Edit.ResetHandOut"}}
      </button>
    </div>
    {{/if}}
    {{!-- No `name` attributes in the item list: saved by its own handlers. --}}
    <div class="mql-reward-items" data-mql-list="reward-items" data-tooltip="{{localize "MQL.Edit.RewardDrop"}}">
      {{#each rewards.items}}
      <div class="mql-reward-row" data-id="{{id}}" data-uuid="{{uuid}}" data-name="{{name}}" data-img="{{img}}">
        <img src="{{img}}" alt="">
        <span class="mql-reward-name">{{name}}</span>
        <input type="number" data-field="quantity" value="{{quantity}}" min="1" step="1"
               aria-label="{{localize "MQL.Edit.Quantity"}}" data-tooltip="{{localize "MQL.Edit.Quantity"}}">
        <button type="button" class="mql-icon-button" data-mql-action="delete-reward"
                data-tooltip="{{localize "MQL.Edit.DeleteReward"}}" aria-label="{{localize "MQL.Edit.DeleteReward"}}">
          <i class="fa-solid fa-trash" inert></i></button>
      </div>
      {{else}}
      <p class="mql-reward-drop-hint"><i class="fa-solid fa-hand-holding" inert></i> {{localize "MQL.Edit.RewardDrop"}}</p>
      {{/each}}
    </div>
    {{#if rewards.currency.length}}
    <div class="form-group">
      <label>{{localize "MQL.Edit.Currency"}}</label>
      <div class="form-fields mql-currency">
        {{#each rewards.currency}}
        <label class="mql-currency-slot">
          {{#if icon}}<i class="{{icon}}" inert></i>{{/if}} {{label}}
          <input type="number" name="{{name}}" value="{{value}}" min="0" step="1">
        </label>
        {{/each}}
      </div>
    </div>
    {{/if}}
    {{formField systemFields.rewards.fields.text value=rewards.text elementType="textarea" stacked=true classes="mql-reward-text"}}
  </fieldset>

  <fieldset class="mql-brief-set">
    <legend><i class="fa-solid fa-user-secret" inert></i> {{localize "MQL.Edit.Brief"}}</legend>
    {{#if briefLocked}}
    <p class="mql-warning"><i class="fa-solid fa-key" inert></i> {{briefLocked}}</p>
    {{else if secretOn}}
    <p class="hint"><i class="fa-solid fa-lock" inert></i> {{localize "MQL.Edit.BriefEncrypted"}}</p>
    {{else}}
    <p class="hint"><i class="fa-solid fa-lock-open" inert></i> {{localize "MQL.Edit.BriefHint"}}</p>
    {{/if}}
    {{#unless briefLocked}}
    <button type="button" class="mql-add" data-mql-action="paste-profile">
      <i class="fa-solid fa-paste" inert></i> {{localize "MQL.Paste.Button"}}
    </button>
    {{/unless}}
    {{#each briefFields}}
    {{formField field value=value elementType="textarea" stacked=true}}
    {{/each}}
  </fieldset>

  {{!-- No `name` attributes in here: follow-ups are saved by their own handlers. --}}
  <fieldset class="mql-follow-ups-set" data-mql-list="follow-ups">
    <legend><i class="fa-solid fa-bell" inert></i> {{localize "MQL.Edit.FollowUps"}}</legend>
    <p class="hint">{{localize "MQL.Edit.FollowUpsHint"}} {{sessionHint}}</p>
    {{#if secretsLocked}}{{#if followUps.length}}
    <p class="mql-warning"><i class="fa-solid fa-key" inert></i> {{localize "MQL.Edit.FollowUpsLocked"}}</p>
    {{/if}}{{/if}}
    {{#if followUps.length}}
    <ol class="mql-follow-up-rows">
      <li class="mql-follow-up-head" aria-hidden="true">
        <span>{{localize "MQL.Edit.FollowUp"}}</span>
        <span>{{localize "MQL.Edit.Session"}}</span>
        <span>{{localize "MQL.Edit.Done"}}</span>
        <span></span>
      </li>
      {{#each followUps}}
      <li class="mql-follow-up-row {{#if due}}mql-due{{/if}}" data-id="{{id}}">
        <input type="text" data-field="text" value="{{text}}"
               placeholder="{{#if ../secretsLocked}}{{localize "MQL.Edit.Encrypted"}}{{else}}{{localize "MQL.Edit.FollowUpPlaceholder"}}{{/if}}"
               aria-label="{{localize "MQL.Edit.FollowUp"}}" {{#if ../secretsLocked}}disabled{{/if}}>
        <input type="number" data-field="session" value="{{session}}" min="1" step="1"
               aria-label="{{localize "MQL.Edit.Session"}}">
        <input type="checkbox" data-field="done" {{checked done}} aria-label="{{localize "MQL.Edit.Done"}}">
        <span class="mql-row-buttons">
          {{#unless ../secretsLocked}}
          <button type="button" class="mql-icon-button" data-mql-action="delete-follow-up"
                  data-tooltip="{{localize "MQL.Edit.DeleteFollowUp"}}" aria-label="{{localize "MQL.Edit.DeleteFollowUp"}}">
            <i class="fa-solid fa-trash" inert></i></button>
          {{/unless}}
        </span>
      </li>
      {{/each}}
    </ol>
    {{else}}
    <p class="mql-none">{{localize "MQL.Edit.NoFollowUps"}}</p>
    {{/if}}
    {{#unless secretsLocked}}
    <button type="button" class="mql-add" data-mql-action="add-follow-up">
      <i class="fa-solid fa-plus" inert></i> {{localize "MQL.Edit.AddFollowUp"}}
    </button>
    {{/unless}}
  </fieldset>
</div>
