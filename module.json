{
  "id": "motherboard-quest-log",
  "title": "Motherboard: Quest Log",
  "description": "A simple quest log as a journal page type: objectives you reveal step by step, a GM brief per quest, and a Quest Log window for everyone. Built for White Signal (Daggerheart).",
  "version": "0.1.0",
  "authors": [
    { "name": "Chezzy" }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14.365",
    "maximum": "14"
  },
  "esmodules": ["scripts/main.mjs"],
  "styles": ["styles/quest-log.css"],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" },
    { "lang": "de", "name": "Deutsch", "path": "lang/en.json" }
  ],
  "socket": true,
  "documentTypes": {
    "JournalEntryPage": {
      "quest": {
        "htmlFields": ["description"],
        "filePathFields": {
          "giver.img": ["IMAGE"]
        }
      }
    }
  }
}
